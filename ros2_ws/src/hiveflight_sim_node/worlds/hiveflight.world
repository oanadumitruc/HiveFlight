<?xml version="1.0"?>
<sdf version="1.7">

  <!--
    HiveFlight demo world.

    The C++ swarm simulates inside the volume x:[0,200] y:[0,200] z:[0,150],
    so this scene is built around (100,100) so the scenery covers the entire
    flight area. Drones and targets are kinematic (the world plugin sets their
    world poses), therefore gravity stays off.

    Highlights:
      - Airfield: 240 m runway + taxiway + apron + helipad + "swarm ops" rings
      - 5 no-fly beacon towers matching the sim obstacle spheres
      - control tower, hangar, pond and tree lines around the field
      - Country road on the south edge: asphalt, shoulders, edge lines,
        dashed centreline, power lines, road signs, traffic (pickup/van)
      - Working farmland: golden wheat field (W), plowed soil field (E),
        green crop field (N), hay bales, red barn + silo, tractor,
        two wind turbines — all kept OUTSIDE the flight volume so the
        swarm never intersects scenery
  -->

  <world name="hiveflight_world">

    <gravity>0 0 0</gravity>

    <!-- ============================================================
         SCENE / SKY / ATMOSPHERE
         ============================================================ -->
    <scene>
      <ambient>0.44 0.47 0.50 1</ambient>
      <background>0.42 0.55 0.75 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <sky>
        <clouds>
          <speed>6</speed>
          <direction>0.5 -0.4 0</direction>
        </clouds>
      </sky>
      <!-- Fog removed on purpose: linear fog greyed out the entire scene at
           demo viewing distances. Clear air keeps drones and scenery crisp
           at any zoom level. -->
    </scene>

    <!-- ============================================================
         SUN
         ============================================================ -->
    <include>
      <uri>model://sun</uri>
      <pose>80 120 180 0.35 -0.28 2.4</pose>
    </include>

    <!-- ============================================================
         TERRAIN
         ============================================================ -->
    <model name="terrain_grass">
      <static>true</static>
      <pose>100 100 -0.25 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <geometry><box><size>340 340 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>340 340 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mown inner lawn framing the airfield -->
    <model name="inner_lawn">
      <static>true</static>
      <pose>100 100 0.02 0 0 0</pose>
      <link name="lawn">
        <visual name="visual">
          <geometry><box><size>240 240 0.02</size></box></geometry>
          <material>
            <ambient>0.25 0.44 0.16 1</ambient>
            <diffuse>0.28 0.52 0.18 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mowed band stripes inside the lawn (visual variety from above) -->
    <model name="lawn_stripes">
      <static>true</static>
      <pose>100 100 0.025 0 0 0</pose>
      <link name="stripes">
        <visual name="band_01"><pose>0 26 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.22 0.40 0.15 1</diffuse></material></visual>
        <visual name="band_02"><pose>0 46 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.22 0.40 0.15 1</diffuse></material></visual>
        <visual name="band_03"><pose>0 66 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.22 0.40 0.15 1</diffuse></material></visual>
        <visual name="band_04"><pose>0 86 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.22 0.40 0.15 1</diffuse></material></visual>
        <visual name="band_05"><pose>0 106 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.22 0.40 0.15 1</diffuse></material></visual>
        <visual name="band_06"><pose>0 126 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.22 0.40 0.15 1</diffuse></material></visual>
        <visual name="band_07"><pose>0 6 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.30 0.48 0.17 1</diffuse></material></visual>
        <visual name="band_08"><pose>0 -14 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.30 0.48 0.17 1</diffuse></material></visual>
        <visual name="band_09"><pose>0 -34 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.30 0.48 0.17 1</diffuse></material></visual>
        <visual name="band_10"><pose>0 -54 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.30 0.48 0.17 1</diffuse></material></visual>
        <visual name="band_11"><pose>0 -74 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.30 0.48 0.17 1</diffuse></material></visual>
        <visual name="band_12"><pose>0 -94 0 0 0 0</pose><geometry><box><size>240 0.8 0.01</size></box></geometry>
          <material><diffuse>0.30 0.48 0.17 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pond -->
    <model name="field_pond">
      <static>true</static>
      <pose>38 30 0 0 0 0</pose>
      <link name="pond">
        <visual name="shore">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><cylinder><radius>7.0</radius><length>0.07</length></cylinder></geometry>
          <material><diffuse>0.55 0.48 0.32 1</diffuse></material>
        </visual>
        <visual name="water">
          <pose>0 0 0.075 0 0 0</pose>
          <geometry><cylinder><radius>5.8</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.25 0.4 1</ambient>
            <diffuse>0.12 0.33 0.5 1</diffuse>
            <emissive>0.06 0.18 0.3 1</emissive>
            <transparency>0.25</transparency>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         AIRFIELD (runway + taxiway + apron + markings + edge lights)
         ============================================================ -->
    <model name="hiveflight_airfield">
      <static>true</static>

      <link name="airfield">

        <!-- Runway surface -->
        <visual name="runway">
          <pose>100 100 0.06 0 0 0</pose>
          <geometry><box><size>34 240 0.12</size></box></geometry>
          <material>
            <ambient>0.09 0.09 0.10 1</ambient>
            <diffuse>0.12 0.125 0.13 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>

        <!-- Runway edge lines -->
        <visual name="edge_line_left">
          <pose>83.4 100 0.135 0 0 0</pose>
          <geometry><box><size>0.5 240 0.02</size></box></geometry>
          <material><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>
        <visual name="edge_line_right">
          <pose>116.6 100 0.135 0 0 0</pose>
          <geometry><box><size>0.5 240 0.02</size></box></geometry>
          <material><diffuse>0.92 0.92 0.88 1</diffuse></material>
        </visual>

        <!-- Centreline dashes -->
        <visual name="dash_01"><pose>100 -70 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_02"><pose>100 -50 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_03"><pose>100 -30 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_04"><pose>100 -10 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_05"><pose>100 10 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_06"><pose>100 30 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_07"><pose>100 50 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_08"><pose>100 70 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_09"><pose>100 90 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_10"><pose>100 110 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_11"><pose>100 130 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_12"><pose>100 150 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_13"><pose>100 170 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_14"><pose>100 190 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="dash_15"><pose>100 210 0.15 0 0 0</pose><geometry><box><size>0.7 5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>

        <!-- Threshold stripes (both ends) -->
        <visual name="thresh_01a"><pose>85.5 -16 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_02a"><pose>92.0 -16 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_03a"><pose>98.5 -16 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_04a"><pose>105.0 -16 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_05a"><pose>111.5 -16 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_01b"><pose>85.5 216 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_02b"><pose>92.0 216 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_03b"><pose>98.5 216 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_04b"><pose>105.0 216 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="thresh_05b"><pose>111.5 216 0.15 0 0 0</pose><geometry><box><size>4.5 1.5 0.02</size></box></geometry><material><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>

        <!-- Wrap-around asphalt pads at the runway ends -->
        <visual name="turnpad_south">
          <pose>100 -25 0.09 0 0 0</pose>
          <geometry><box><size>34 8 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.11 1</ambient><diffuse>0.14 0.145 0.15 1</diffuse></material>
        </visual>
        <visual name="turnpad_north">
          <pose>100 225 0.09 0 0 0</pose>
          <geometry><box><size>34 8 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.11 1</ambient><diffuse>0.14 0.145 0.15 1</diffuse></material>
        </visual>

        <!-- Taxiway (runway East side -> apron) -->
        <visual name="taxiway">
          <pose>92 90 0.06 0 0 0</pose>
          <geometry><box><size>64 12 0.12</size></box></geometry>
          <material><ambient>0.09 0.09 0.10 1</ambient><diffuse>0.12 0.125 0.13 1</diffuse></material>
        </visual>
        <visual name="taxi_centerline">
          <pose>86 90 0.15 0 0 0</pose>
          <geometry><box><size>40 0.5 0.02</size></box></geometry>
          <material><diffuse>0.92 0.85 0.4 1</diffuse></material>
        </visual>

        <!-- Apron -->
        <visual name="apron">
          <pose>50 90 0.05 0 0 0</pose>
          <geometry><box><size>35 32 0.1</size></box></geometry>
          <material><ambient>0.11 0.11 0.12 1</ambient><diffuse>0.15 0.155 0.16 1</diffuse></material>
        </visual>

        <!-- Runway edge lights (glowing) -->
        <visual name="re_l_01"><pose>81.7 -15 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_02"><pose>81.7 15 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_03"><pose>81.7 45 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_04"><pose>81.7 75 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_05"><pose>81.7 105 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_06"><pose>81.7 135 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_07"><pose>81.7 165 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_l_08"><pose>81.7 195 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_01"><pose>118.3 -7 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_02"><pose>118.3 15 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_03"><pose>118.3 45 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_04"><pose>118.3 75 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_05"><pose>118.3 105 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_06"><pose>118.3 135 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_07"><pose>118.3 165 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
        <visual name="re_r_08"><pose>118.3 195 0.35 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.28</length></cylinder></geometry><material><diffuse>0.05 0.5 0.3 1</diffuse><emissive>0.05 0.8 0.45 1</emissive></material></visual>
      </link>
    </model>

    <!-- ============================================================
         HELIPAD
         ============================================================ -->
    <model name="helipad">
      <static>true</static>
      <pose>45 150 0 0 0 0</pose>
      <link name="pad">
        <visual name="pad_base">
          <pose>0 0 0.045 0 0 0</pose>
          <geometry><cylinder><radius>8.0</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.11 1</ambient><diffuse>0.13 0.135 0.14 1</diffuse></material>
        </visual>
        <!-- Yellow border ring -->
        <visual name="ring_yellow">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry><cylinder><radius>7.6</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.95 0.72 0.15 1</diffuse></material>
        </visual>
        <visual name="ring_center">
          <pose>0 0 0.115 0 0 0</pose>
          <geometry><cylinder><radius>6.7</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.2 0.2 0.21 1</diffuse></material>
        </visual>
        <!-- White "H" -->
        <visual name="h_bar_fl">
          <pose>-1.1 0 0.13 0 0 0</pose>
          <geometry><box><size>0.8 3.4 0.02</size></box></geometry>
          <material><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="h_bar_fr">
          <pose>1.1 0 0.13 0 0 0</pose>
          <geometry><box><size>0.8 3.4 0.02</size></box></geometry>
          <material><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="h_cross">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry><box><size>2.6 0.8 0.02</size></box></geometry>
          <material><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="h_cross_alt">
          <pose>0 0 0.133 0 0 0</pose>
          <geometry><box><size>2.6 0.8 0.02</size></box></geometry>          <material><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

        <!-- Swarm ops concentric rings surrounding the helipad -->
    <model name="swarm_ops_disc">
      <static>true</static>
      <pose>150 165 0 0 0 0</pose>
      <link name="ops">
        <visual name="ops_base">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>16</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.11 1</ambient><diffuse>0.14 0.145 0.15 1</diffuse></material>
        </visual>
        <visual name="ring_o_yellow">
          <pose>0 0 0.085 0 0 0</pose>
          <geometry><cylinder><radius>14</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.95 0.72 0.15 1</diffuse></material>
        </visual>
        <visual name="ring_o_inner">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry><cylinder><radius>13.0</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.18 0.19 0.2 1</diffuse></material>
        </visual>
        <visual name="ring_w_white">
          <pose>0 0 0.115 0 0 0</pose>
          <geometry><cylinder><radius>10.8</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.92 0.93 0.9 1</diffuse></material>
        </visual>
        <visual name="ring_w_inner">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry><cylinder><radius>9.9</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.16 0.17 0.18 1</diffuse></material>
        </visual>
        <visual name="ring_c_cyan">
          <pose>0 0 0.145 0 0 0</pose>
          <geometry><cylinder><radius>7.0</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.05 0.75 0.95 1</diffuse></material>
        </visual>
        <visual name="ring_c_inner">
          <pose>0 0 0.16 0 0 0</pose>
          <geometry><cylinder><radius>6.0</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.15 0.16 0.17 1</diffuse></material>
        </visual>
        <visual name="core_magenta">
          <pose>0 0 0.175 0 0 0</pose>
          <geometry><cylinder><radius>3.6</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.85 0.25 0.7 1</diffuse></material>
        </visual>
        <visual name="core_inner">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><cylinder><radius>2.6</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.16 0.17 0.18 1</diffuse></material>
        </visual>
        <visual name="core_target">
