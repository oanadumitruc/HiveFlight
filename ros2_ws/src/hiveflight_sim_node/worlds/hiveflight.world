<?xml version="1.0"?>
<sdf version="1.6">
  <world name="hiveflight_world">
    <gravity>0 0 0</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.08 0.08 0.12 1</background>
    </scene>
    <include><uri>model://ground_plane</uri></include>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
    </plugin>
    <!-- Applies swarm PoseArray topics directly on the physics thread:
         one message updates ALL drones each step (no service round-robin). -->
    <plugin name="hiveflight_pose_plugin" filename="libhiveflight_pose_plugin.so">
      <swarm_id>0</swarm_id>
    </plugin>
  </world>
</sdf>