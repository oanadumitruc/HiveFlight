  <!-- Demo-ready starting viewpoint: zoomed-out SW establishing shot.
       The whole airfield, road and farm fields are visible at open, with
       the 3x-scaled drone swarm framed over the field centre. -->
  <gui>
    <camera name="user_camera">
      <pose>0 -50 95 0 0.35 0.98</pose>
    </camera>
  </gui>

