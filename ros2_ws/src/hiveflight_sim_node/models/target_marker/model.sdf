<?xml version="1.0"?>
<sdf version="1.7">

  <!--
    HiveFlight target_marker - a sleek, demo-ready "pursue me" aircraft.
    The HiveFlight world plugin owns its pose (kinematic, gravity-free).

    The bridge replaces __RED__ __GREEN__ __BLUE__ with the team colour so
    the target livery matches its assigned swarm team.

    Axes: +X is the nose, +Y is the wingspan direction, +Z is up.
  -->

  <model name="target_marker">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="aircraft">

      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <self_collide>false</self_collide>

      <!-- ============================================================
           FUSELAGE + NOSE
           ============================================================ -->
      <visual name="fuselage">
        <pose>0 0 0.12 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.24</radius><length>4.4</length></cylinder></geometry>
        <material>
          <ambient>__RED__ __GREEN__ __BLUE__ 1</ambient>
          <diffuse>__RED__ __GREEN__ __BLUE__ 1</diffuse>
          <specular>0.75 0.75 0.75 1</specular>
        </material>
      </visual>

      <!-- Skin stripe along the upper fuselage -->
      <visual name="fuselage_stripe">
        <pose>0 0 0.16 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.248</radius><length>4.0</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.12 0.14 1</ambient>
          <diffuse>0.03 0.035 0.04 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <visual name="nose">
        <pose>2.32 0 0.12 0 0 0</pose>
        <geometry><sphere><radius>0.25</radius></sphere></geometry>
        <material>
          <ambient>0.78 0.8 0.82 1</ambient>
          <diffuse>0.9 0.92 0.94 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>

      <!-- Cockpit canopy -->
      <visual name="canopy">
        <pose>1.05 0 0.34 0 0 0</pose>
        <geometry><sphere><radius>0.2</radius></sphere></geometry>
        <material>
          <ambient>0.03 0.07 0.12 1</ambient>
          <diffuse>0.04 0.1 0.18 1</diffuse>
          <specular>0.95 0.95 1 1</specular>
        </material>
      </visual>

      <!-- ============================================================
           MAIN WING
           ============================================================ -->
      <visual name="main_wing">
        <pose>0.6 0 0.12 0 0 0</pose>
        <geometry><box><size>0.9 4.8 0.07</size></box></geometry>
        <material>
          <ambient>__RED__ __GREEN__ __BLUE__ 1</ambient>
          <diffuse>__RED__ __GREEN__ __BLUE__ 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Leading-edge sweep highlight -->
      <visual name="sweep_left">
        <pose>0.85 1.45 0.165 0 0.06 0</pose>
        <geometry><box><size>0.7 1.6 0.05</size></box></geometry>
        <material>
          <ambient>0.85 0.87 0.9 1</ambient>
          <diffuse>0.92 0.94 0.96 1</diffuse>
        </material>
      </visual>
      <visual name="sweep_right">
        <pose>0.85 -1.45 0.165 0 -0.06 0</pose>
        <geometry><box><size>0.7 1.6 0.05</size></box></geometry>
        <material>
          <ambient>0.85 0.87 0.9 1</ambient>
          <diffuse>0.92 0.94 0.96 1</diffuse>
        </material>
      </visual>

      <!-- Winglets -->
      <visual name="winglet_left">
        <pose>0.55 2.42 0.42 0 0 -0.15</pose>
        <geometry><box><size>0.08 0.025 0.7</size></box></geometry>
        <material>
          <ambient>__RED__ __GREEN__ __BLUE__ 1</ambient>
          <diffuse>__RED__ __GREEN__ __BLUE__ 1</diffuse>
        </material>
      </visual>
      <visual name="winglet_right">
        <pose>0.55 -2.42 0.42 0 0 0.15</pose>
        <geometry><box><size>0.08 0.025 0.7</size></box></geometry>
        <material>
          <ambient>__RED__ __GREEN__ __BLUE__ 1</ambient>
          <diffuse>__RED__ __GREEN__ __BLUE__ 1</diffuse>
        </material>
      </visual>

      <!-- Wing nav beacons -->
      <visual name="wing_nav_left">
        <pose>0.6 2.42 0.16 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <material>
          <ambient>0.05 1 0.2 1</ambient>
          <diffuse>0.05 1 0.2 1</diffuse>
          <emissive>0.05 0.8 0.15 1</emissive>
        </material>
      </visual>
      <visual name="wing_nav_right">
        <pose>0.6 -2.42 0.16 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <material>
          <ambient>1 0.05 0.05 1</ambient>
          <diffuse>1 0.05 0.05 1</diffuse>
          <emissive>0.85 0.02 0.02 1</emissive>
        </material>
      </visual>

      <!-- ============================================================
           EMPENNAGE (tail)
           ============================================================ -->
      <visual name="tailplane">
        <pose>-1.6 0 0.3 0 0 0</pose>
        <geometry><box><size>0.4 2.3 0.06</size></box></geometry>
        <material>
          <ambient>__RED__ __GREEN__ __BLUE__ 1</ambient>
          <diffuse>__RED__ __GREEN__ __BLUE__ 1</diffuse>
        </material>
      </visual>
      <visual name="fin_top">
        <pose>-1.7 0 0.85 0 0 0</pose>
        <geometry><box><size>0.95 0.1 0.8</size></box></geometry>
        <material>
          <ambient>__RED__ __GREEN__ __BLUE__ 1</ambient>
          <diffuse>__RED__ __GREEN__ __BLUE__ 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="tail_boom">
        <pose>-1.1 0 0.3 0 0.15 0</pose>
        <geometry><box><size>0.6 0.06 0.06</size></box></geometry>
        <material><diffuse>0.2 0.22 0.24 1</diffuse></material>
      </visual>

      <!-- ============================================================
           PROPULSION (twin engine pods + pusher propeller)
           ============================================================ -->
      <visual name="engine_left">
        <pose>-0.55 1.05 0.1 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.55</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.13 0.14 1</ambient>
          <diffuse>0.16 0.17 0.18 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="engine_right">
        <pose>-0.55 -1.05 0.1 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.55</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.13 0.14 1</ambient>
          <diffuse>0.16 0.17 0.18 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>

      <!-- Spinning-style pusher prop behind the wing -->
      <visual name="prop_disc">
        <pose>-0.9 0 0.3 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.55</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.62 0.66 1</ambient>
          <diffuse>0.7 0.72 0.76 1</diffuse>
          <transparency>0.6</transparency>
        </material>
      </visual>
      <visual name="prop_blade_a">
        <pose>-0.65 0 0.3 0 1.570796 0.0</pose>
        <geometry><box><size>1.05 0.03 0.015</size></box></geometry>
        <material><diffuse>0.3 0.32 0.35 1</diffuse></material>
      </visual>
      <visual name="prop_blade_b">
        <pose>-0.65 0 0.3 0 1.570796 0.785</pose>
        <geometry><box><size>1.05 0.02 0.015</size></box></geometry>
        <material><diffuse>0.3 0.32 0.35 1</diffuse></material>
      </visual>
      <visual name="prop_spinner">
        <pose>-0.62 0 0.3 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><diffuse>0.1 0.1 0.11 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
      </visual>

      <!-- ============================================================
           LIGHTS + TARGET BEACON
           ============================================================ -->
      <!-- Big glowing target ring on the spine -->
      <visual name="target_ring">
        <pose>0.1 0 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.6</radius><length>0.015</length></cylinder></geometry>
        <material>
          <ambient>1 0.25 0.05 1</ambient>
          <diffuse>1 0.3 0.05 1</diffuse>
          <emissive>1 0.3 0.05 1</emissive>
          <lighting>false</lighting>
        </material>
      </visual>

      <!-- Translucent halo above the ring -->
      <visual name="target_halo">
        <pose>0.1 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.95</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>1 0.4 0.1 1</ambient>
          <diffuse>1 0.4 0.1 1</diffuse>
          <emissive>0.9 0.35 0.08 1</emissive>
          <lighting>false</lighting>
          <transparency>0.4</transparency>
        </material>
      </visual>

      <!-- Anti-collision strobe on the fin -->
      <visual name="strobe_mast">
        <pose>-1.7 0 1.28 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.12</length></cylinder></geometry>
        <material><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="strobe_light">
        <pose>-1.7 0 1.36 0 0 0</pose>
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material>
          <ambient>1 0.03 0.02 1</ambient>
          <diffuse>1 0.04 0.02 1</diffuse>
          <emissive>1 0.02 0.01 1</emissive>
        </material>
      </visual>
      <visual name="strobe_halo">
        <pose>-1.7 0 1.36 0 0 0</pose>
        <geometry><sphere><radius>0.22</radius></sphere></geometry>
        <material>
          <ambient>1 0.1 0.05 1</ambient>
          <diffuse>1 0.1 0.05 1</diffuse>
          <emissive>0.8 0.1 0.04 1</emissive>
          <lighting>false</lighting>
          <transparency>0.55</transparency>
        </material>
      </visual>

      <!-- Landing-light spill cones (visible from the ground) -->
      <visual name="landing_beam_left">
        <pose>0.3 0.9 0.05 0 3.14 0</pose>
        <geometry><cylinder><radius>0.36</radius><length>1.6</length></cylinder></geometry>
        <material>
          <ambient>1 0.95 0.7 1</ambient>
          <diffuse>1 0.95 0.7 1</diffuse>
          <emissive>0.9 0.85 0.6 1</emissive>
          <lighting>false</lighting>
          <transparency>0.7</transparency>
        </material>
      </visual>
      <visual name="landing_beam_right">
        <pose>0.3 -0.9 0.05 0 3.14 0</pose>
        <geometry><cylinder><radius>0.36</radius><length>1.6</length></cylinder></geometry>
        <material>
          <ambient>1 0.95 0.7 1</ambient>
          <diffuse>1 0.95 0.7 1</diffuse>
          <emissive>0.9 0.85 0.6 1</emissive>
          <lighting>false</lighting>
          <transparency>0.7</transparency>
        </material>
      </visual>

      <!-- Nose lamp -->
      <visual name="nose_lamp">
        <pose>2.28 0 -0.02 0 0 0</pose>
        <geometry><sphere><radius>0.055</radius></sphere></geometry>
        <material>
          <ambient>1 0.98 0.8 1</ambient>
          <diffuse>1 0.98 0.8 1</diffuse>
          <emissive>0.9 0.88 0.7 1</emissive>
        </material>
      </visual>

      <!-- Belly turret look / landing strut -->
      <visual name="belly_pod">
        <pose>0.4 0 -0.12 0 0 0</pose>
        <geometry><box><size>0.7 0.3 0.12</size></box></geometry>
        <material><diffuse>0.12 0.13 0.14 1</diffuse></material>
      </visual>

      <!-- Compact collision body -->
      <collision name="collision">
        <geometry><box><size>5.0 4.9 1.9</size></box></geometry>
        <surface>
          <friction><ode><mu>0</mu><mu2>0</mu2></ode></friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>