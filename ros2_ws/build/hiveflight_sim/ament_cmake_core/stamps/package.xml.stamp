<?xml version="1.0"?>
<package format="3">
  <name>hiveflight_sim</name>
  <version>0.0.1</version>
  <description>ROS 2 integration for HiveFlight simulation (adapter only)</description>
  <maintainer email="devnull@example.com">devnull</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>hiveflight_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>


